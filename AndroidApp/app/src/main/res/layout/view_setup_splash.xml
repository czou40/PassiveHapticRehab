<?xml version="1.0" encoding="utf-8"?>
<!--
    Full-screen splash / Wi-Fi setup overlay.
    Shown on top of the main menu until the device is connected to Wi-Fi
    with a working internet connection. One panel is visible at a time.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="32dp">

        <!-- Skip for now (top corner): closes the splash without saving setup
             progress, so the next app launch prompts again. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_skip_setup"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/setup_skip_button"
            android:textAllCaps="false"
            android:textSize="18sp" />

        <!-- App header -->
        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/setup_app_name"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/setup_app_name"
            android:textColor="@color/black"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Step progress dots: 1 = Wi-Fi connected, 2 = internet checked, 3 = done -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot_step_1"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/dot_setup_inactive" />

            <View
                android:layout_width="24dp"
                android:layout_height="2dp"
                android:background="#FFE0E0E0" />

            <View
                android:id="@+id/dot_step_2"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/dot_setup_inactive" />

            <View
                android:layout_width="24dp"
                android:layout_height="2dp"
                android:background="#FFE0E0E0" />

            <View
                android:id="@+id/dot_step_3"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/dot_setup_inactive" />
        </LinearLayout>

        <TextView
            android:id="@+id/setup_step_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/setup_text_secondary"
            android:textSize="18sp" />

        <!-- State panels: exactly one is visible at a time -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Checking connection (initial splash) -->
            <LinearLayout
                android:id="@+id/layout_checking"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ProgressBar
                    android:layout_width="72dp"
                    android:layout_height="72dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:text="@string/setup_checking"
                    android:textColor="@color/black"
                    android:textSize="24sp" />
            </LinearLayout>

            <!-- Step 1: not connected to Wi-Fi yet (Wi-Fi off or no network selected) -->
            <LinearLayout
                android:id="@+id/layout_connect_wifi"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:contentDescription="@string/setup_connect_title"
                    android:src="@drawable/ic_setup_wifi" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:text="@string/setup_connect_title"
                    android:textColor="@color/black"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/setup_connect_sub"
                    android:textColor="@color/setup_text_secondary"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/setup_connect_why"
                    android:textColor="@color/setup_text_secondary"
                    android:textSize="20sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_connect_wifi"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:minHeight="80dp"
                    android:backgroundTint="@color/setup_primary"
                    android:text="@string/setup_connect_button"
                    android:textAllCaps="false"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Step 2: connected, waiting for internet -->
            <LinearLayout
                android:id="@+id/layout_internet_check"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="72dp"
                    android:layout_height="72dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:text="@string/setup_internet_title"
                    android:textColor="@color/black"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/setup_internet_sub"
                    android:textColor="@color/setup_text_secondary"
                    android:textSize="22sp" />
            </LinearLayout>

            <!-- Wi-Fi connected but no internet (shown after a wait) -->
            <LinearLayout
                android:id="@+id/layout_no_internet"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:contentDescription="@string/setup_no_internet_title"
                    android:src="@drawable/ic_setup_wifi" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:text="@string/setup_no_internet_title"
                    android:textColor="@color/black"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/setup_no_internet_sub"
                    android:textColor="@color/setup_text_secondary"
                    android:textSize="22sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_try_again"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:minHeight="80dp"
                    android:backgroundTint="@color/setup_primary"
                    android:text="@string/setup_no_internet_button"
                    android:textAllCaps="false"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Success -->
            <LinearLayout
                android:id="@+id/layout_success"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:contentDescription="@string/setup_success_title"
                    android:src="@drawable/ic_setup_check" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:text="@string/setup_success_title"
                    android:textColor="@color/setup_success"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/setup_success_sub"
                    android:textColor="@color/setup_text_secondary"
                    android:textSize="22sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_continue"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:minHeight="80dp"
                    android:backgroundTint="@color/setup_success"
                    android:text="@string/setup_continue_button"
                    android:textAllCaps="false"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</ScrollView>
